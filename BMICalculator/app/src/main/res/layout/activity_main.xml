<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Chọn giới tính (Men / Women) -->
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/rbMen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="Men"
            android:textColor="#4CAF50" />
        <RadioButton
            android:id="@+id/rbWomen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Women"
            android:textColor="#4CAF50" />
    </RadioGroup>

    <!-- Hàng nhập Tuổi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Age"
            android:textSize="18sp"/>
        <EditText
            android:id="@+id/edtAge"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textAlignment="center"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Yrs"
            android:textColor="#4CAF50"
            android:textAlignment="viewEnd"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- Hàng nhập Cân nặng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Weight"
            android:textSize="18sp"/>
        <EditText
            android:id="@+id/edtWeight"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textAlignment="center"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Kg"
            android:textColor="#4CAF50"
            android:textAlignment="viewEnd"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- Hàng nhập Chiều cao -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Height"
            android:textSize="18sp"/>
        <EditText
            android:id="@+id/edtHeight"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textAlignment="center"/>
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Cm"
            android:textColor="#4CAF50"
            android:textAlignment="viewEnd"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- 2 Nút bấm RESULT và RESET -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <Button
            android:id="@+id/btnResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RESULT"
            android:textStyle="bold"
            android:onClick="tinhBMI"
            android:layout_marginEnd="8dp" />
        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RESET"
            android:textStyle="bold"
            android:onClick="resetData"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Ô kết quả nền xanh lá như ảnh -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4CAF50"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:text="0.0"
        android:textAlignment="center"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <!-- Bảng phân loại tĩnh (Cứng) -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0,1">

        <TableRow
            android:padding="8dp">
            <TextView
                android:text="UnderWeight"
                android:textColor="#29B6F6"
                android:textAlignment="center"
                android:textStyle="bold"/>
            <TextView
                android:text="&lt; 20"
                android:textColor="#29B6F6"
                android:textAlignment="center"
                android:textStyle="bold"/>
        </TableRow>

        <TableRow
            android:padding="8dp">
            <TextView
                android:text="Normal"
                android:textColor="#4CAF50"
                android:textAlignment="center"
                android:textStyle="bold"/>
            <TextView
                android:text="20 - 25"
                android:textColor="#4CAF50"
                android:textAlignment="center"
                android:textStyle="bold"/>
        </TableRow>

        <TableRow
            android:padding="8dp">
            <TextView
                android:text="OverWeight"
                android:textColor="#FFEE58"
                android:textAlignment="center"
                android:textStyle="bold"/>
            <TextView
                android:text="25 - 30"
                android:textColor="#FFEE58"
                android:textAlignment="center"
                android:textStyle="bold"/>
        </TableRow>

        <TableRow
            android:padding="8dp">
            <TextView
                android:text="Obese"
                android:textColor="#FFA726"
                android:textAlignment="center"
                android:textStyle="bold"/>
            <TextView
                android:text="30 - 40"
                android:textColor="#FFA726"
                android:textAlignment="center"
                android:textStyle="bold"/>
        </TableRow>

        <TableRow
            android:padding="8dp">
            <TextView
                android:text="Morbidly Obese"
                android:textColor="#EF5350"
                android:textAlignment="center"
                android:textStyle="bold"/>
            <TextView
                android:text="&gt; 40"
                android:textColor="#EF5350"
                android:textAlignment="center"
                android:textStyle="bold"/>
        </TableRow>

    </TableLayout>

</LinearLayout>